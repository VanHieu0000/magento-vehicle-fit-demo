<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="vehiclefit" translate="label" sortOrder="300" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Vehicle Fitment</label>
            <tab>catalog</tab>
            <resource>Hieu_VehicleFit::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable vehicle filter</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="cache_lifetime" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Fitment cache lifetime (seconds)</label>
                    <comment>Cache is also cleaned by tag after every import, so this is only a safety net.</comment>
                    <validate>validate-digits validate-zero-or-greater</validate>
                </field>
            </group>
        </section>
    </system>
</config>
